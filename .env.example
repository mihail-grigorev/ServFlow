# Параметры подключения к PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5434/kofeservice

# Google Gemini API (модель gemini-2.5-flash)
# Если ключ не задан, автоматически работает встроенный детерминированный fallback-анализатор по П-1..П-10
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# JWT авторизация
JWT_SECRET=super-secret-kofeservice-jwt-key-2026

# Опорная дата системы (System Reference Date)
SYSTEM_REFERENCE_DATE=2026-11-16T11:30:00

