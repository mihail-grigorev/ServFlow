# База данных PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5434/kofeservice

# Режим работы (true для демо, false для продакшена)
DEMO_MODE=true
DEMO_STAFF_PIN=2026
PUBLIC_BASE_URL=http://localhost:5173

# Аналитический слой ClickHouse (необязательно, при отсутствии работает fallback на Postgres)
# CLICKHOUSE_URL=http://localhost:8123

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3-flash-preview

# JWT авторизация (для продакшена сгенерируйте стойкий случайный ключ)
JWT_SECRET=super-secret-kofeservice-jwt-key-2026

# Опорная дата системы (System Reference Date)
SYSTEM_REFERENCE_DATE=2026-11-16T11:30:00

# Яндекс Почта (SMTP) для кодов верификации
YANDEX_SMTP_HOST=smtp.yandex.ru
YANDEX_SMTP_PORT=465
YANDEX_SMTP_USER=servflow@yandex.ru
YANDEX_SMTP_PASSWORD=your-yandex-app-password
YANDEX_SMTP_FROM_NAME=servflow@yandex.ru
